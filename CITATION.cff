    given-names: Ronish
    orcid: "https://orcid.org/0009-0000-8835-5380"
version: 0.1.0
date-released: "2026-10-31"
license: MIT
repository-code: "https://github.com/sunmoonron/wdd-playground"
keywords:
  - mechanistic interpretability
  - provenance
  - attribution
  - residual stream
  - weight-dictionary decomposition
  - sparse autoencoders
  - GPT-2
